[Unit]
Description=FB Group Crawler Daemon
After=network-online.target

[Service]
Type=simple
User=tk578
WorkingDirectory=/home/tk578/.openclaw/workspace/fb-group-scraper
ExecStart=/home/tk578/.openclaw/workspace/fb-group-scraper/venv/bin/python3 /home/tk578/.openclaw/workspace/fb-group-scraper/run_scheduler.py --daemon
Restart=always
RestartSec=60
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
