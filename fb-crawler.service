[Unit]
Description=FB Group Crawler Daemon (Anti-Detection)
After=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/fb-group-scraper
Environment=DISPLAY=:99
ExecStart=/home/ec2-user/fb-group-scraper/venv/bin/python3 /home/ec2-user/fb-group-scraper/run_scheduler.py --daemon
Restart=always
RestartSec=120

[Install]
WantedBy=default.target
